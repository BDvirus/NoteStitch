<Page
    x:Class="NoteStitch.ShortcutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16">

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Set Keyboard Shortcut"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Content -->
        <StackPanel Grid.Row="1" Spacing="12">

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Hotkey:  Ctrl + Alt +" VerticalAlignment="Center"/>
                <ComboBox x:Name="KeyCombo" Width="72"/>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2,0,2"/>

            <TextBlock Text="Action" FontWeight="SemiBold"/>

            <RadioButton x:Name="OpenRadio"
                         Content="Open NoteStitch"
                         IsChecked="True"
                         GroupName="ShortcutAction"/>

            <RadioButton x:Name="AutoSaveRadio"
                         Content="⚡ Auto Save &amp; Close all Notepads"
                         GroupName="ShortcutAction"/>

            <TextBlock x:Name="WarnLabel"
                       Text="⚠ Configure auto-save folder in Settings first"
                       Foreground="OrangeRed"
                       FontSize="11"
                       Visibility="Collapsed"/>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancelClicked"/>
            <Button Content="Create Shortcut"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnCreateClicked"/>
        </StackPanel>

    </Grid>
</Page>
