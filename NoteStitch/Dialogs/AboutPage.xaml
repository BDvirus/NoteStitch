<Page
    x:Class="NoteStitch.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16">

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="About NoteStitch"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Content -->
        <StackPanel Grid.Row="1" Spacing="12">

            <!-- App identity -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Border Width="64"
                        Height="64"
                        CornerRadius="16"
                        Background="Transparent"
                        VerticalAlignment="Top">
                    <Image x:Name="AppIcon"
                           Width="40"
                           Height="40"
                           Source="ms-appx:///Assets/notes.png"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="NoteStitch"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="VersionLabel"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12"/>
                    <TextBlock Text="Stitch multiple Notepad windows into one document."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- About text -->
            <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Created by "/>
                    <Run Text="Dvirus" FontWeight="SemiBold"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="GitHub:"
                               VerticalAlignment="Center"/>
                    <HyperlinkButton Content="github.com/BDvirus/NoteStitch"
                                     NavigateUri="https://github.com/BDvirus/NoteStitch"
                                     Padding="0"
                                     HorizontalAlignment="Left"/>
                </StackPanel>

                <TextBlock Text="NoteStitch detects all open Notepad windows and merges their content into a single document. Supports Windows 10 and Windows 11 (including multi-tab Notepad)."
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Vision -->
            <TextBlock Text="Vision" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="Planned: cloud sync, multi-format export, and global hotkey merge."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" FontSize="12"/>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Close" Click="OnCloseClicked"/>
        </StackPanel>

    </Grid>
</Page>
