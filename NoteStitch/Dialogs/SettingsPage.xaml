<Page
    x:Class="NoteStitch.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20,16,20,16">

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Content -->
        <StackPanel Grid.Row="1" Spacing="12">

            <!-- Auto-save folder -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Auto-save folder:" VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="FolderBox" Width="200" PlaceholderText="(not set)"/>
                <Button Content="Browse…" Click="OnBrowseClicked"/>
            </StackPanel>

            <!-- Separator -->
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>

            <TextBlock Text="Filter" FontWeight="SemiBold"/>

            <CheckBox x:Name="IncludeSavedCb"
                      Content="Include saved files (tabs linked to a file on disk)"/>

            <CheckBox x:Name="IncludeMergedCb"
                      Content="Include previously merged files (merged_notepads_…)"/>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>

            <TextBlock Text="Startup" FontWeight="SemiBold"/>

            <CheckBox x:Name="RunOnStartupCb"
                      Content="Run on Windows startup"/>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancelClicked"/>
            <Button Content="Save"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveClicked"/>
        </StackPanel>

    </Grid>
</Page>
