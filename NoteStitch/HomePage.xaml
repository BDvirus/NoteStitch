<Page
    x:Class="NoteStitch.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NoteStitch"
    >

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8,0,8,0">

     

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="NoteStitch"
                   FontFamily="Segoe UI Variable Display"
                   FontSize="20" FontWeight="SemiBold"
                   Margin="4,14,0,4"/>

        <!-- Status / info label -->
        <TextBlock Grid.Row="1" x:Name="InfoLabel"
                   Text="Scanning…"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Margin="6,0,0,6"/>

        <!-- Notepad document checklist -->
        <ListView Grid.Row="2" x:Name="DocList"
                  SelectionMode="None"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="2">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="4,2,4,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" MinHeight="28">
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Content="{Binding Filename}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CharCountText}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Button bar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    Spacing="6" Margin="0,8,0,8">
            <Button x:Name="ToggleAllButton" Content="Deselect All"
                    Click="OnToggleAll"/>
            <Button x:Name="MergeButton"
                    Content="🔀 Merge"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnMergeClicked"/>
            <Button x:Name="AutoMergeButton"
                    Content="⚡ Auto Save"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnAutoMergeClicked"/>
            <Button x:Name="ShortcutButton"
                    Content="⌨ Shortcut…"
                    Click="OnShortcutClicked"/>
        </StackPanel>
    </Grid>
</Page>
