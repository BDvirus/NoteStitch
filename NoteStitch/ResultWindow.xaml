<Window
    x:Class="NoteStitch.ResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    Margin="8,8,8,4" VerticalAlignment="Center">
            <Button Content="◀  Back" Click="OnBackClicked"/>
            <TextBlock x:Name="TitleLabel"
                       FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Merged text viewer -->
        <ScrollViewer Grid.Row="1" Margin="8,0,8,0">
            <RichEditBox x:Name="MergedTextBox"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="13"
                         BorderThickness="0"
                         Background="Transparent"
                         IsTabStop="False"/>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    Spacing="6" Margin="8,8,8,10">
            <Button Content="Copy to Clipboard"         Click="OnCopyClicked"/>
            <Button Content="Save to File…"             Click="OnSaveClicked"/>
            <Button Content="Save &amp; Close Notepads"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveAndCloseClicked"/>
        </StackPanel>

    </Grid>
</Window>
